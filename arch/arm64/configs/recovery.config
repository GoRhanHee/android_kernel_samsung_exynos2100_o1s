# Disable Scamsung Security
CONFIG_MST_LDO=n
CONFIG_MST_V2=n
CONFIG_MST_TEEGRIS=n
CONFIG_MST_LPM_CONTROL=n
CONFIG_HDM=n
CONFIG_SDP=n
CONFIG_FSCRYPT_SDP=n
CONFIG_DDAR=n
CONFIG_EXYRNG_FIPS_COMPLIANCE=n
CONFIG_CRYPTO_FIPS=n
CONFIG_EXYNOS_FMP_FIPS=n

# Disable other useless features for recovery to save space
CONFIG_ANDROID_BINDERFS=n
CONFIG_BPF_JIT=n
CONFIG_BPF_JIT_ALWAYS_ON=n
CONFIG_DM_SNAPSHOT=n
CONFIG_DUMMY=n
CONFIG_CPU_FREQ_GOV_POWERSAVE=n
CONFIG_CPU_FREQ_GOV_USERSPACE=n
CONFIG_CPU_FREQ_GOV_ONDEMAND=n
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=n
CONFIG_TCP_CONG_WESTWOOD=n
CONFIG_TCP_CONG_HTCP=n
CONFIG_IOSCHED_BFQ=n
CONFIG_CRYPTO_LZ4=n
CONFIG_CRYPTO_ZSTD=n
CONFIG_INITIAL_TCP_BUFFER=n
CONFIG_PROC_SPOOF_CMDLINE=n

# Recovery Config
CONFIG_AUDIT=n
CONFIG_KSU=n
CONFIG_SECURITY_SELINUX_ALWAYS_ENFORCE=n
CONFIG_SECURITY_SELINUX_ALWAYS_PERMISSIVE=y
CONFIG_KMI_SYMBOL_LISTS="android/abi_gki_aarch64 android/abi_gki_aarch64_exynos android/abi_gki_aarch64_qcom android/abi_gki_aarch64_sunxi android/abi_gki_aarch64_unisoc android/abi_gki_aarch64_hikey960 android/abi_gki_aarch64_cuttlefish android/abi_gki_aarch64_db845c android/abi_gki_aarch64_goldfish android/abi_gki_aarch64_oneplus android/abi_gki_aarch64_oplus android/abi_gki_aarch64_vivo android/abi_gki_aarch64_exynosauto android/abi_gki_aarch64_imx android/abi_gki_aarch64_sony android/abi_gki_aarch64_xiaomi android/abi_gki_aarch64_galaxy android/abi_gki_aarch64_galaxy_presubmit abi_greylist"